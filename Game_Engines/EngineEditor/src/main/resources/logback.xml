<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- 控制台日志 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                [%d{yyyy-MM-dd HH:mm:ss.SSS}] [%thread] [%highlight(%-5level){
                    TRACE=green, DEBUG=magenta, INFO=blue, WARN=yellow, ERROR=red
                }] %logger{36}.%M:%L - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- 日志级别 -->
    <logger name="xyz.topover" level="debug"/>

    <!-- Root 级别，默认输出到控制台 -->
    <root level="debug">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>