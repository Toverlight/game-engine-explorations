<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchorPane" onKeyPressed="#onAnchorPressed" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="editor.sculpt.Controller">
   <children>
      <MenuBar prefHeight="25.0" prefWidth="183.0">
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem fx:id="fileNew" mnemonicParsing="false" onAction="#onFileNew" text="New" />
                  <MenuItem mnemonicParsing="false" text="Save" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Edit">
            <items>
              <MenuItem mnemonicParsing="false" text="Delete" />
            </items>
          </Menu>
            <Menu mnemonicParsing="false" text="View">
              <items>
                <MenuItem mnemonicParsing="false" text="ewe" />
              </items>
            </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <Canvas fx:id="canvas" height="371.0" layoutX="121.0" layoutY="27.0" onMouseClicked="#onCanvasClicked" onMouseDragged="#onCanvasDragged" onMouseExited="#onCanvasExited" onMouseMoved="#onCanvasMoved" onMousePressed="#onCanvasPressed" onMouseReleased="#onCanvasReleased" onScroll="#onCanvasScroll" width="479.0" />
      <Label layoutX="16.0" layoutY="43.0" text="DrawParams">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <ColorPicker fx:id="strokeColorPicker" layoutX="8.0" layoutY="94.0" onAction="#onStrokePick" prefHeight="23.0" prefWidth="100.0" />
      <Label layoutX="23.0" layoutY="77.0" text="stroke color">
         <tooltip>
            <Tooltip text="边线颜色" />
         </tooltip></Label>
      <ColorPicker fx:id="fillColorPicker" layoutX="8.0" layoutY="146.0" onAction="#onFillPick" prefHeight="23.0" prefWidth="100.0" />
      <Label layoutX="34.0" layoutY="129.0" text="fill color">
         <tooltip>
            <Tooltip text="填充颜色" />
         </tooltip></Label>
      <Label layoutX="29.0" layoutY="181.0" text="line width">
         <tooltip>
            <Tooltip text="边线宽度" />
         </tooltip></Label>
      <Spinner fx:id="lineWidthSpinner" layoutX="6.0" layoutY="198.0" prefHeight="23.0" prefWidth="100.0" />
      <Separator layoutY="233.0" prefWidth="120.0" />
      <Label layoutX="33.0" layoutY="249.0" text="Vertex">
         <font>
            <Font size="14.0" />
         </font>
         <tooltip>
            <Tooltip text="当前操作的顶点" />
         </tooltip>
      </Label>
      <TextField disable="true" layoutX="15.0" layoutY="278.0" prefHeight="23.0" prefWidth="44.0" fx:id="xTf" />
      <TextField fx:id="yTf" disable="true" layoutX="73.0" layoutY="278.0" prefHeight="23.0" prefWidth="44.0" />
      <Label layoutX="6.0" layoutY="282.0" text="x" />
      <Label layoutX="62.0" layoutY="282.0" text="y" />
      <Button fx:id="removeVertexButton" disable="true" layoutX="25.0" layoutY="365.0" mnemonicParsing="false" onAction="#onRemoveVertex" text="Remove" />
      <Label layoutX="33.0" layoutY="312.0" text="Mouse">
         <font>
            <Font size="14.0" />
         </font>
         <tooltip>
            <Tooltip text="鼠标当前坐标：relative是画布坐标，absolute是世界坐标" />
         </tooltip>
      </Label>
      <Label fx:id="mouseCorLabel" alignment="CENTER" layoutX="7.0" layoutY="330.0" prefHeight="18.0" prefWidth="100.0" />
      <Label fx:id="mouseWorldCorLabel" alignment="CENTER" layoutX="7.0" layoutY="347.0" prefHeight="18.0" prefWidth="100.0" />
   </children>
</AnchorPane>
